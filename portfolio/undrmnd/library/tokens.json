{
  "$schema": "https://undrmnd.com/library/tokens.schema.json",
  "name": "undrmnd",
  "version": "1.0.0",
  "description": "Non-addictive, e-ink-inspired design tokens for undrmnd. Intent-named. Open source.",
  "philosophy": {
    "summary": "Translate a physical e-ink reader to the screen. Counter dopamine-driven UI. Simple and open source.",
    "hinge": "The library should send you outside more often than it pulls you in.",
    "refusals": [
      "infinite scroll without gates",
      "streaks karma leaderboards false scarcity",
      "phantom notifications fake urgency",
      "autoplay by default",
      "dopamine palettes glow effects pill clusters",
      "AI as oracle",
      "tracking SDKs without consent"
    ]
  },
  "surfaces": {
    "paper": { "token": "paper", "role": "Default editorial reading ground" },
    "night": { "token": "night", "role": "Hero and deep sections; warm charcoal" },
    "eink": { "token": "eink", "role": "Paperwhite device metaphor for slow reading" }
  },
  "color": {
    "paper": { "value": "#f1ece1", "css": "--paper", "use": "Page ground" },
    "paper-raised": { "value": "#e8e1d1", "css": "--paper-raised", "use": "Quiet lift for specimens" },
    "fog": { "value": "#d4cdb9", "css": "--fog", "use": "Obscured map / atmosphere" },
    "hairline": { "value": "#b9b09a", "css": "--hairline", "use": "Borders and soft structure" },
    "graphite-600": { "value": "#3a3833", "css": "--graphite-600", "use": "Secondary text, nav, captions" },
    "ink": { "value": "#1b1a17", "css": "--ink", "aliases": ["graphite-900"], "use": "Primary text" },
    "accent": { "value": "#5a4a2f", "css": "--accent", "use": "Emphasis, italic hinge, links" },
    "accent-soft": { "value": "#8a7551", "css": "--accent-soft", "use": "Softer cues on dark" },
    "night": { "value": "#16140f", "css": "--night", "use": "Dark ground" },
    "night-raised": { "value": "#1f1c16", "css": "--night-raised", "use": "Panels on night" },
    "night-hairline": { "value": "#3a342a", "css": "--night-hairline", "use": "Borders on night" },
    "night-text": { "value": "#e9e2d1", "css": "--night-text", "use": "Primary text on night" },
    "night-muted": { "value": "#aea493", "css": "--night-muted", "use": "Secondary on night" },
    "eink": { "value": "#cfc7b4", "css": "--eink", "use": "Paperwhite ground" },
    "eink-deep": { "value": "#b6ad99", "css": "--eink-deep", "use": "Bezel / deeper frame" },
    "eink-ink": { "value": "#2a2820", "css": "--eink-ink", "use": "Ink on paperwhite" }
  },
  "typography": {
    "families": {
      "serif": { "name": "MD Lórien", "css": "--serif", "roles": ["display", "section", "body", "quote"] },
      "sans": { "name": "MD UI", "css": "--sans", "roles": ["label", "nav", "button", "chrome"] },
      "mono": { "name": "ui-monospace", "css": "--mono", "roles": ["code"] }
    },
    "roles": {
      "display": { "size": "clamp(48px, 8vw, 96px)", "lineHeight": 1.02, "family": "serif" },
      "section": { "size": "clamp(28px, 3.4vw, 44px)", "lineHeight": 1.1, "family": "serif", "note": "Italic hinge word in accent" },
      "body": { "size": "18px", "lineHeight": 1.6, "measure": "62ch", "family": "serif", "weight": 350 },
      "label": { "size": "12px", "letterSpacing": "0.04em", "family": "sans", "weight": 500 },
      "button": { "size": "14px", "letterSpacing": "0.04em", "family": "sans", "weight": 500 }
    }
  },
  "space": {
    "gutter": { "css": "--gutter", "value": "40px" },
    "measure": { "css": "--measure", "value": "62ch" }
  },
  "motion": {
    "ease-out": "cubic-bezier(0.2, 0.7, 0.1, 1)",
    "ease-soft": "cubic-bezier(0.16, 1, 0.3, 1)",
    "respect": "prefers-reduced-motion",
    "allowed": ["fog reveal", "scroll reveal", "header hide/show", "paper grain"],
    "discouraged": ["bounce", "glow pulses", "confetti", "autoplay motion"]
  },
  "patterns": [
    { "id": "finite-sessions", "summary": "Explicit end; no one-more loops" },
    { "id": "fog-reveal", "summary": "Spatial reveal by reading/contribution" },
    { "id": "strata-object", "summary": "Schema-backed knowledge unit, not a post" },
    { "id": "friction-as-feature", "summary": "Gates and reflective pauses" },
    { "id": "field-notes-outside", "summary": "Push attention into the world" },
    { "id": "ai-sparingly", "summary": "Intent + related only; not an oracle" },
    { "id": "time-honest", "summary": "Calm estimates; real citations" },
    { "id": "one-job-section", "summary": "Lean hero and section budget" }
  ],
  "components": [
    { "id": "btn", "classes": [".btn", ".btn-ghost", ".btn-on-dark"], "notes": "No rounded-full pills; invert on hover" },
    { "id": "label", "classes": [".label", ".eyebrow"] },
    { "id": "paperwhite", "classes": [".paperwhite", ".paperwhite-frame", ".pw-screen"] },
    { "id": "kindle", "classes": [".kindle", ".kindle-screen"] },
    { "id": "strata-card", "classes": [".strata-card"], "notes": "Interaction container for knowledge objects" },
    { "id": "sound-dock", "classes": [".sound-dock"], "notes": "Companion to reading" }
  ],
  "sources": {
    "css": "./styles.css",
    "human": "./library.html",
    "design": "./DESIGN.md",
    "app": "https://github.com/eremmele/undrmnd"
  }
}
